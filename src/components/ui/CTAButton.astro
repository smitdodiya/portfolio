---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
}

const { href, label, variant = "primary" } = Astro.props;
const baseClass =
  "inline-flex items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition duration-300 hover:-translate-y-0.5";
const variantClass =
  variant === "secondary"
    ? "border border-slate-700 bg-slate-900/70 text-slate-200 hover:border-sky-400/70 hover:text-sky-200"
    : "bg-sky-400/90 text-slate-950 hover:bg-sky-300";
---

<a
  href={href}
  class:list={[baseClass, variantClass]}
>
  {label}
</a>
