---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-8 space-y-3">
  <h2 class="text-2xl font-bold tracking-tight text-slate-100 sm:text-3xl md:text-4xl">{title}</h2>
  {subtitle && <p class="max-w-2xl text-sm leading-relaxed text-slate-400 sm:text-base md:text-lg">{subtitle}</p>}
</div>
