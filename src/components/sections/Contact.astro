---
import SectionHeading from "../ui/SectionHeading.astro";

const contacts = [
  {
    label: "Email",
    value: "smitkdodiya@gmail.com",
    href: "mailto:smitkdodiya@gmail.com",
    icon: "✉",
  },
  {
    label: "LinkedIn",
    value: "linkedin.com/in/smitdodiya",
    href: "https://www.linkedin.com/in/smitdodiya/",
    icon: "in",
  },
  {
    label: "GitHub",
    value: "github.com/smitdodiya",
    href: "https://github.com/smitdodiya",
    icon: "<>",
  },
];
---

<section id="contact" class="section-base reveal" style="--reveal-delay: 0.2s;">
  <SectionHeading title="Contact" subtitle="Let us connect and build something meaningful" />
  <div class="interactive-card rounded-2xl border border-slate-700/70 bg-slate-900/60 p-5 shadow-xl shadow-slate-950/40 backdrop-blur-sm sm:p-6">
    <p class="mb-5 text-sm leading-relaxed text-slate-300 sm:text-base">
      I am always open to discussing product ideas, engineering challenges, and collaborative opportunities.
    </p>

    <div class="grid gap-3 sm:grid-cols-3">
      {contacts.map((contact) => (
        <a
          href={contact.href}
          target={contact.label === "Email" ? undefined : "_blank"}
          rel={contact.label === "Email" ? undefined : "noreferrer"}
          class="interactive-card group flex items-center gap-3 rounded-xl border border-slate-700/70 bg-slate-900/80 px-3 py-3 shadow-sm shadow-slate-950/30 hover:bg-slate-800/70"
        >
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-slate-700 bg-slate-800/80 text-xs font-semibold text-sky-200">
            {contact.icon}
          </span>
          <span>
            <span class="block text-xs text-slate-400">{contact.label}</span>
            <span class="block text-sm text-slate-200 group-hover:text-sky-200">{contact.value}</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
